<?xml version="1.0" encoding="utf-8"?>
<!--
  화면 위에 떠 있는 플로팅 마이크.

  - 루트(floating_root)와 마이크 버튼을 끌면 위치가 움직이고, 끌지 않고 탭하면 녹음이 시작/정지된다.
  - 녹음 중에는 위쪽 배지에 경과 시간이 뜨고, 오른쪽 위 ✕ 로 플로팅 모드 자체를 닫는다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/floating_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_badge"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="@string/floating_listening_short"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/floating_mic"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:contentDescription="@string/mic_desc_floating_idle"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text=""
            app:backgroundTint="@color/brand"
            app:cornerRadius="34dp"
            app:icon="@drawable/ic_mic_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="30dp"
            app:iconTint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/floating_close"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:contentDescription="@string/btn_floating_close"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/action_close"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            app:backgroundTint="@color/floating_chrome"
            app:cornerRadius="13dp" />
    </FrameLayout>
</LinearLayout>
